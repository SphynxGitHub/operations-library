{
  "manifest_version": 3,
  "name": "Sphynx OL Time Tracker",
  "short_name": "OL Timer",
  "version": "1.0.0",
  "description": "Start and stop timers on Operations Library tasks from any tab. Time lands on the task's logged hours.",
  "action": {
    "default_popup": "popup.html",
    "default_title": "OL Time Tracker",
    "default_icon": { "16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png" }
  },
  "icons": { "16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png" },
  "background": { "service_worker": "background.js", "type": "module" },
  "permissions": ["storage", "alarms", "notifications", "idle"],
  "host_permissions": ["https://kexnnpwjerrnsmifauuo.supabase.co/*"]
}
